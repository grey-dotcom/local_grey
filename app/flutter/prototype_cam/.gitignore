# =============================================
# prototype_cam Flutter 모듈 전용 .gitignore
# =============================================

# Flutter 빌드 결과물 (설치 시 자동 생성됨 — 공유 불필요)
/build/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies

# 패키지 캐시 (flutter pub get으로 자동 복원)
.pub-cache/
.pub/

# IDE 설정
.idea/
*.iml

# macOS 시스템 파일
.DS_Store

# 로그
*.log

# 민감 정보 (API 키 등)
.env
.env.*

# iOS 빌드 (네이티브 빌드 시 자동 생성)
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec

# Android 빌드
android/.gradle/
android/captures/
android/gradlew
android/gradlew.bat
android/local.properties

# Web 빌드 결과물
web/build/
.dart_tool/chrome-device/

# pubspec.lock은 포함 (개발자 간 동일 패키지 버전 보장)
# !pubspec.lock

# macOS 데스크탑 앱 (출시 계획 없음 — Flutter가 필요 시 자동 생성)
macos/
