# =============================================
# prototype_cam_ts (Next.js) 전용 .gitignore
# =============================================

# 빌드 결과물 (npm run build 시 자동 생성)
.next/
out/
dist/

# 패키지 (npm install 로 자동 복원)
node_modules/

# 환경변수 (API 키 등 민감 정보 — 절대 올리면 안 됨)
.env
.env.local
.env.*.local

# 로그
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# TypeScript 빌드 캐시
*.tsbuildinfo
next-env.d.ts

# Firebase 배포 캐시 (배포 시 자동 생성)
.firebase/

# Firebase 설정 (로컬 전용)
.firebaserc
firebase.json
